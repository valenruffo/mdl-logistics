# Copy this file to `.env` (ignored by git) or export the variable in your shell.
#
# MDL_STORE_ORIGIN — the store admin origin whose Envío Nube app will be driven.
# Required: the executor refuses to start without it. Shape: https:// + host.
# Never commit the real value; `.env.example` is blocked by the harness guard,
# so the documented example lives here instead.
MDL_STORE_ORIGIN=https://your-store.example.com
