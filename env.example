# Copy this file to `.env` (ignored by git) or export the variables in your shell.
#
# `.env.example` is blocked by the harness guard, so the documented example lives here.

# MDL_STORE_ORIGIN — the store admin origin whose Envío Nube app will be driven.
# Required. Shape: https:// + host. The executor refuses to start without it.
MDL_STORE_ORIGIN=https://your-store.example.com

# MDL_HEADLESS — true on a server with no display, false locally.
# Accepts exactly true/false. Default: false.
MDL_HEADLESS=false

# MDL_STORAGE_STATE — a Playwright storageState JSON transferred from a human login.
# When set, the browser runs non-persistently from that file instead of the profile.
# Server deployments use this. Local development leaves it unset.
# MDL_STORAGE_STATE=/run/mdl/storage-state.json

# MDL_PROFILE — local persistent browser profile directory (holds the session).
# Only used when MDL_STORAGE_STATE is unset. Keep it outside the repository.
# MDL_PROFILE=C:\Users\<you>\.mdl\browser-profile

# MDL_PASSWORD_HASH — the operator's one password, stored as a salted scrypt hash.
# Required. The app refuses to start without it: there is no default password.
# Shape: scrypt$N$r$p$salt$key (the salt is inside the string, so every password
# has its own). Generate it with node, passing the password as an argument:
#
#   node -e "const c=require('node:crypto'),s='\x24',pw=process.argv[1],salt=c.randomBytes(16),N=16384,r=8,p=1,key=c.scryptSync(pw,salt,32,{N,r,p});console.log(['scrypt',N,r,p,salt.toString('hex'),key.toString('hex')].join(s))" 'TU-CONTRASENA'
#
# The command prints the value only; save it in the environment, not in the
# repository. Note that the password you type as an argument can end up in your
# shell history — clear that line afterwards if that matters on this machine.
# MDL_PASSWORD_HASH=scrypt$16384$8$1$<32 hex chars>$<64 hex chars>

# MDL_SESSION_SECRET — the HMAC-SHA256 key that signs the session cookie.
# Required. At least 32 characters; the app never invents one. Generate it with:
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Rotating it invalidates every existing session, which is the intended way to
# sign everyone out at once. The app's own login page replaces the proxy-level
# Basic Auth dialog: MDL_PASSWORD_HASH and this secret are the only credentials
# the UI needs.
# MDL_SESSION_SECRET=<64 hex chars>
